# ServiceSync Backend Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=servicesync_dev
DB_USER=postgres
DB_PASSWORD=SevenSins58!&

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=8h

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
# Max file size in bytes (10MB)

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window

# Email Configuration (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@company.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=ServiceSync <noreply@icumechanical.com>

# External API Keys (for future integrations)
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
PARTSTOWNS_API_KEY=your_partstown_api_key
ALLPOINTS_API_KEY=your_allpoints_api_key

# GPS/Mapping Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/servicesync.log

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=another_super_secret_session_key

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
# Daily at 2 AM (cron format)
BACKUP_RETENTION_DAYS=30

# Development Configuration
ENABLE_CORS=true
ENABLE_LOGGING=true
ENABLE_API_DOCS=true

# Google Maps Configuration
REACT_APP_GOOGLE_MAPS_API_KEY=AIzaSyB_49va4RfcshTBXBO7O07aV5ZGm8Wr5kY

# Backend API Configuration
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_WS_URL=http://localhost:5000

# App Configuration
REACT_APP_COMPANY_NAME="ICU Mechanical"
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development